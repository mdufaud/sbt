# Copy this file to keystore.properties (and GITIGNORE it) and fill in the real
# values. sbt reads it when `android_sign_config` points at it; the passwords are
# loaded by Gradle at configure time, never written into a generated file.
#
# `storeFile` is resolved relative to this file's directory.
storeFile=keystores/release.keystore
storePassword=CHANGE_ME
keyAlias=release
keyPassword=CHANGE_ME
